MYSQL_HOST=127.0.0.1
MYSQL_USER=echo
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=echo
MYSQL_PORT=3306
# MySQL TLS: verification is ON by default. For a private/self-signed DB CA,
# point MYSQL_SSL_CA at the CA bundle (PEM). For local dev only, set
# MYSQL_SSL_INSECURE=true to skip verification (logs a warning; never use in prod).
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_INSECURE=false
DOMAIN=https://endless.social
FRONTEND_ORIGIN=https://endless.social

# Public frontend defaults baked into web/native builds (runtime relay settings still apply).
VITE_WS_RELAY_URL=wss://echo.endless.social
VITE_GUN_RELAY_URL=https://echo2.endless.social/gun
VITE_API_BASE_URL=https://echo.endless.social
VITE_WEB_ORIGIN=https://endless.social
# Optional direct release-asset overrides; do not use a GitHub release page URL.
# Windows defaults to the bundled /downloads/Echo-Setup.exe installer.
# VITE_DESKTOP_DOWNLOAD_URL=https://github.com/Interpoll1/decentralised/releases/download/v1.2.0/Echo-Setup.exe
# Android defaults to the bundled /downloads/Echo-Android.apk package.
# VITE_ANDROID_APK_URL=https://github.com/Interpoll1/decentralised/releases/download/android-latest/Echo-Android.apk
# VITE_IOS_DOWNLOAD_URL=https://apps.apple.com/app/your-echo-app-id
JWT_SECRET=replace-with-32-byte-random-secret
VOTE_RESERVATION_SECRET=replace-with-32-byte-random-secret
