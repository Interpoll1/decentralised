MYSQL_HOST=127.0.0.1
MYSQL_USER=interpoll
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=interpoll
MYSQL_PORT=3306
# MySQL TLS: verification is ON by default. For a private/self-signed DB CA,
# point MYSQL_SSL_CA at the CA bundle (PEM). For local dev only, set
# MYSQL_SSL_INSECURE=true to skip verification (logs a warning; never use in prod).
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_INSECURE=false
DOMAIN=https://endless.sbs
FRONTEND_ORIGIN=https://endless.sbs
# Optional direct release-asset overrides; do not use a GitHub release page URL.
# Windows defaults to the bundled /downloads/InterPoll-Setup.exe installer.
# VITE_DESKTOP_DOWNLOAD_URL=https://github.com/Interpoll1/decentralised/releases/download/v1.2.0/InterPoll-Setup.exe
# Android defaults to the bundled /downloads/InterPoll-Android.apk package.
# VITE_ANDROID_APK_URL=https://github.com/Interpoll1/decentralised/releases/download/android-latest/InterPoll-Android.apk
# VITE_IOS_DOWNLOAD_URL=https://apps.apple.com/app/your-interpoll-app-id
JWT_SECRET=replace-with-32-byte-random-secret
VOTE_RESERVATION_SECRET=replace-with-32-byte-random-secret
