# InterPoll — Apache/LiteSpeed config for the static SPA at endless.sbs

# ---------------------------------------------------------------------------
# 1. MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType text/javascript .js
</IfModule>

# ---------------------------------------------------------------------------
# 2. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript \
        application/javascript application/json application/manifest+json \
        image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 3. SPA fallback
#
# Real files and directories (blog pages, /games, /cassandra, assets) are
# served as-is.  Only declared InterPoll routes render index.html.  Do not use
# a catch-all fallback here: this document root is shared with other projects
# such as /about, which must be allowed to reach their own files/handlers.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(sw\.js|registerSW\.js|manifest\.webmanifest)$ - [L]
    RewriteRule ^assets2/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Extensionless pages owned by other projects: /about serves /about.html
    # when that file exists.  This must precede the InterPoll route allowlist.
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # InterPoll's root plus its static and parameterised client-side routes.
    RewriteRule ^$ /index.html [L]
    RewriteRule ^(?:onboarding|home|communities|spaces|create|create-community|create-poll|profile|settings|network|chain-explorer|search|resilience|claim-username|chatrooms)(?:/|$) /index.html [L,NC]
    RewriteRule ^(?:community|poll|post|user|u|vote|results|receipt|chat|chatroom|join)(?:/|$) /index.html [L,NC]
    RewriteRule ^auth/callback(?:/|$) /index.html [L,NC]
</IfModule>
