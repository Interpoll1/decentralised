# InterPoll — Apache/LiteSpeed config for the static SPA at endless.sbs

# ---------------------------------------------------------------------------
# 1. MIME types
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType text/javascript .js
</IfModule>

# ---------------------------------------------------------------------------
# 2. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript \
        application/javascript application/json application/manifest+json \
        image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# 3. SPA fallback
#
# Real files and directories (blog pages, /games, /cassandra, assets) are
# served as-is; every other path renders index.html so shared deep links
# (/post/x, /community/x/poll/y, /chat, /join/...) open the app instead of 404.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^(sw\.js|registerSW\.js|manifest\.webmanifest)$ - [L]
    RewriteRule ^assets2/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule . /index.html [L]
</IfModule>
